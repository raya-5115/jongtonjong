generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PerangkatDesa {
  id                 String   @id @default(cuid())
  nama               String
  jabatan            String
  nip                String?
  telepon            String?
  pendidikanTerakhir String?
  foto               String?
  masaJabatan        String?
  urutan             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  image     String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Umkm {
  id            String   @id @default(cuid())
  businessName  String
  ownerName     String
  productImage  String?
  description   String
  address       String
  phone         String
  googleMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  image       String
  description String?
  createdAt   DateTime @default(now())
}

model Service {
  id          String           @id @default(cuid())
  name        String
  description String?
  requirement String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requests    ServiceRequest[]
}

model ServiceRequest {
  id               String                     @id @default(cuid())
  submissionNumber String                     @unique
  serviceId        String
  fullName         String
  nik              String
  phone            String
  address          String
  description      String?
  status           RequestStatus              @default(PENDING)
  note             String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  service          Service                    @relation(fields: [serviceId], references: [id])
  attachments      ServiceRequestAttachment[]
}

model ServiceRequestAttachment {
  id               String         @id @default(cuid())
  serviceRequestId String
  fileName         String
  fileUrl          String
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum RequestStatus {
  PENDING
  PROCESS
  FINISHED
  REJECTED
}

model Facility {
  id          String           @id @default(cuid())
  name        String
  category    FacilityCategory
  description String?
  address     String?
  phone       String?
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum FacilityCategory {
  PENDIDIKAN
  KESEHATAN
  KEAGAMAAN
  OLAHRAGA
  PEMERINTAHAN
  SOSIAL
  LAINNYA
}

model VillageProfile {
  id          String   @id @default(cuid())
  villageName String   @default("Desa Tonjong")
  title       String   @default("Mengenal Desa Tonjong")
  image       String?
  description String
  vision      String
  mission     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
